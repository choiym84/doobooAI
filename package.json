{
  "name": "discord-ai-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:up": "docker compose -f compose.local.yml up -d db",
    "db:down": "docker compose -f compose.local.yml down"
  },
  "dependencies": {
    "@google/genai": "^1.0.0",
    "discord.js": "^14.0.0",
    "dotenv": "^16.0.0",
    "pg": "^8.0.0",
    "pino": "^9.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^3.0.0"
  }
}
