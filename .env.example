# Local runtime
APP_ENV=local
LOG_LEVEL=info
PORT=3000

# Local PostgreSQL started by `npm run db:up`
DATABASE_URL=postgresql://assistant:assistant@localhost:5433/discord_assistant

# Discord Developer Portal > Bot > Token. Never commit this value.
DISCORD_BOT_TOKEN=
DISCORD_INPUT_CHANNEL_ID=

# AI provider selection. Only the Gemini adapter is planned initially.
AI_PROVIDER=gemini
AI_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=
